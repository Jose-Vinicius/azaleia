<div class="flex h-screen bg-[#09090b] text-[#fafafa] overflow-hidden">
  <%= render "shared/sidebar" %>

  <main class="flex-1 overflow-y-auto p-4 md:p-8 hide-scrollbar">
    <div class="max-w-3xl mx-auto space-y-6">
      <div class="flex items-center gap-3 border-b border-[#27272a] pb-4">
        <%= link_to okrs_path, class: "p-2 rounded-lg bg-[#18181b] hover:bg-[#27272a] text-[#a1a1aa] transition-colors" do %>
          <span class="material-symbols-outlined text-xl">arrow_back</span>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-[#fafafa]">Novo OKR da Empresa</h1>
          <p class="text-xs text-[#a1a1aa]">Defina o Objetivo para o trimestre atual.</p>
        </div>
      </div>

      <div class="bg-[#121215] border border-[#27272a] rounded-xl p-6 shadow-xl">
        <%= render "form", okr: @okr %>
      </div>
    </div>
  </main>
</div>
