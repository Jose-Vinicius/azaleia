<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-4xl bg-surface-container border border-outline-variant rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
      
      <!-- TopAppBar -->
      <header class="flex justify-between items-center px-6 h-16 w-full bg-zinc-950 border-b border-zinc-800 shrink-0">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-[24px]">receipt_long</span>
          <div>
            <h1 class="text-base font-bold text-on-surface">Histórico de Logs de IA</h1>
            <p class="text-xs text-on-surface-variant">Registro detalhado de chamadas à API Gemini (Requests & Responses)</p>
          </div>
        </div>
        <button onclick="document.getElementById('modal').innerHTML = ''" class="text-on-surface-variant hover:text-on-surface hover:bg-zinc-900 transition-colors p-2 rounded-lg cursor-pointer">
          <span class="material-symbols-outlined">close</span>
        </button>
      </header>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto p-6 space-y-4 bg-background">
        <% if @logs.empty? %>
          <div class="p-12 text-center text-on-surface-variant space-y-3 bg-surface-container/40 rounded-xl border border-outline-variant/40">
            <span class="material-symbols-outlined text-[48px] opacity-40">history_toggle_off</span>
            <p class="text-sm">Nenhum log de IA registrado até o momento.</p>
          </div>
        <% else %>
          <div class="space-y-3">
            <% @logs.each do |log| %>
              <div class="p-4 bg-surface-container/60 border border-outline-variant/60 rounded-xl hover:border-primary/40 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="space-y-1 flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <% if log.success? %>
                      <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">check_circle</span> Sucesso
                      </span>
                    <% else %>
                      <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-red-500/10 text-red-400 border border-red-500/20 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]">error</span> Erro
                      </span>
                    <% end %>

                    <span class="text-sm font-bold text-on-surface truncate"><%= log.action_name %></span>
                    <span class="text-xs text-on-surface-variant px-2 py-0.5 rounded bg-surface-container-lowest border border-outline-variant/40"><%= log.ai_model %></span>
                  </div>

                  <div class="flex items-center gap-4 text-xs text-on-surface-variant flex-wrap pt-1">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">schedule</span> <%= log.created_at.strftime('%d/%m/%Y %H:%M:%S') %>
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">timer</span> <%= log.duration_ms || 0 %> ms
                    </span>
                    <% if log.total_tokens.present? %>
                      <span class="flex items-center gap-1 text-primary">
                        <span class="material-symbols-outlined text-[14px]">token</span> <%= log.total_tokens %> tokens
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="w-full md:w-auto shrink-0 flex items-center gap-2">
                  <%= link_to show_log_ai_path(log), data: { turbo_frame: "modal" }, class: "px-4 py-2 bg-primary/10 text-primary hover:bg-primary/20 font-bold text-xs rounded-xl border border-primary/20 transition-all flex items-center gap-1 cursor-pointer" do %>
                    <span class="material-symbols-outlined text-[16px]">visibility</span> Detalhes
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Footer -->
      <footer class="flex justify-between items-center px-6 py-4 bg-surface-container border-t border-outline-variant shrink-0">
        <% if @logs.any? %>
          <%= button_to clear_logs_ai_path, method: :delete, data: { turbo_confirm: "Tem certeza que deseja apagar todo o histórico de logs de IA?" }, class: "px-4 py-2 text-xs font-bold text-error bg-error/10 border border-error/20 rounded-xl hover:bg-error/20 transition-colors flex items-center gap-1 cursor-pointer" do %>
            <span class="material-symbols-outlined text-[16px]">delete_sweep</span> Limpar Histórico
          <% end %>
        <% else %>
          <div></div>
        <% end %>

        <button onclick="document.getElementById('modal').innerHTML = ''" class="px-5 py-2 text-xs font-bold text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
          Fechar
        </button>
      </footer>
    </div>
  </div>
<% end %>
