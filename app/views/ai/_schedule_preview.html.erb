<% if defined?(@schedule_result) && @schedule_result.present? %>
  <div class="bg-surface-container/80 border border-primary/30 rounded-2xl p-6 space-y-6 shadow-xl relative overflow-hidden">
    <div class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none">
      <span class="material-symbols-outlined text-[120px] text-primary">calendar_clock</span>
    </div>

    <!-- Header & Summary -->
    <div class="space-y-2">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-xl bg-primary/10 text-primary border border-primary/20">
          <span class="material-symbols-outlined text-[24px]">auto_awesome_motion</span>
        </div>
        <div>
          <h3 class="text-lg font-bold text-on-surface">Prévia do Agendamento Inteligente pela IA</h3>
          <p class="text-xs text-on-surface-variant">Confira a distribuição sugerida com base na sua rotina e horários de trabalho. Ajuste as datas se necessário antes de confirmar.</p>
        </div>
      </div>

      <% if @schedule_result["summary"].present? %>
        <div class="p-4 bg-primary/5 border border-primary/20 rounded-xl text-sm text-on-surface space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-primary flex items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">psychology</span> Estratégia Adotada pela IA:
          </span>
          <p class="text-xs leading-relaxed text-on-surface-variant"><%= @schedule_result["summary"] %></p>
        </div>
      <% end %>
    </div>

    <% suggestions = @schedule_result["suggestions"] || [] %>
    <% if suggestions.empty? %>
      <div class="p-6 text-center text-sm text-on-surface-variant bg-surface-container-lowest border border-outline-variant/40 rounded-xl">
        Nenhuma tarefa em aberto pendente de agendamento no momento.
      </div>
    <% else %>
      <%= form_with url: apply_open_tasks_schedule_ai_path, method: :post, class: "space-y-4" do |f| %>
        <div class="space-y-3 max-h-[500px] overflow-y-auto pr-1 hide-scrollbar">
          <% suggestions.each do |sugg| %>
            <% task = @open_tasks[sugg["task_id"].to_i] %>
            <% next unless task %>
            <% 
              parsed_time = Time.zone.parse(sugg["suggested_schedule_at"].to_s) rescue nil
              formatted_val = parsed_time ? parsed_time.strftime("%Y-%m-%dT%H:%M") : nil
            %>

            <div class="p-4 bg-surface-container-lowest border border-outline-variant/60 rounded-xl hover:border-primary/40 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
              <!-- Selection & Task Info -->
              <div class="flex items-start gap-3 flex-1 min-w-0">
                <input type="hidden" name="schedule[<%= task.id %>][selected]" value="0">
                <input type="checkbox" name="schedule[<%= task.id %>][selected]" value="1" checked class="mt-1 w-4 h-4 text-primary bg-surface-container border-outline-variant rounded focus:ring-primary focus:ring-offset-0 cursor-pointer">
                
                <div class="space-y-1 min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-bold text-on-surface truncate"><%= task.title %></span>
                    <% if task.multiplier %>
                      <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-primary/10 text-primary border border-primary/20">
                        <%= task.multiplier.name %>
                      </span>
                    <% end %>
                    <span class="text-[11px] text-on-surface-variant flex items-center gap-1">
                      <span class="material-symbols-outlined text-[14px]">schedule</span> <%= task.estimated_minutes || 30 %> min
                    </span>
                  </div>

                  <p class="text-xs text-primary/90 italic flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">lightbulb</span> <%= sugg["reasoning"] %>
                  </p>
                </div>
              </div>

              <!-- Date Time Input -->
              <div class="w-full md:w-auto shrink-0 space-y-1">
                <label class="block text-[10px] font-bold text-on-surface-variant uppercase tracking-wider">Data & Horário Sugerido</label>
                <input type="datetime-local" name="schedule[<%= task.id %>][schedule_at]" value="<%= formatted_val %>" class="w-full md:w-auto bg-surface-container border border-outline-variant rounded-lg px-3 py-1.5 text-xs text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent outline-none">
              </div>
            </div>
          <% end %>
        </div>

        <div class="pt-4 border-t border-outline-variant/40 flex justify-end">
          <%= f.submit "✅ Confirmar e Aplicar Agendamento", data: { disable_with: "⏳ Salvando agendamentos..." }, class: "px-6 py-2.5 bg-primary text-on-primary font-bold text-xs rounded-xl shadow-lg shadow-primary/20 hover:opacity-90 transition-all cursor-pointer" %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
