<% if @analysis_markdown.present? %>
  <div class="bg-surface-container/60 border border-outline-variant/60 rounded-2xl p-6 md:p-8 space-y-6">
    <div class="flex items-center gap-2 border-b border-outline-variant/40 pb-4">
      <span class="material-symbols-outlined text-primary text-[24px]">description</span>
      <h3 class="text-lg font-bold text-on-surface">Relatório Diagnóstico de IA (Período: <%= @period_days %> dias)</h3>
    </div>

    <div class="prose prose-invert max-w-none text-sm leading-relaxed space-y-4">
      <%= Kramdown::Document.new(@analysis_markdown).to_html.html_safe %>
    </div>
  </div>
<% end %>
