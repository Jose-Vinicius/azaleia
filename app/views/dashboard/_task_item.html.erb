<% is_overdue = task.schedule_at.present? && task.schedule_at.to_date < Date.today %>
<% is_completed = task.completed == true %>
<% is_discarded = task.completed == false %>
<% is_done = !task.completed.nil? %>

<div class="group relative flex items-start gap-3 p-3 rounded hover:bg-surface-variant transition-colors border border-transparent <%= is_overdue && !is_done ? 'hover:border-error/30' : 'hover:border-outline-variant/50' %> shrink-0 <%= is_done ? 'dashboard-completed-task' : '' %>" data-task-item>
  <% if is_completed %>
    <%# Completed — green filled check, click to revert %>
    <%= button_to task_path(task, task: { completed: nil }), method: :patch, class: "z-10 relative mt-0.5 transition-colors", form: { data: { turbo_frame: "_top" } } do %>
      <span class="material-symbols-outlined text-tertiary text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
    <% end %>
  <% elsif is_discarded %>
    <%# Discarded — red X, click to revert %>
    <%= button_to task_path(task, task: { completed: nil }), method: :patch, class: "z-10 relative mt-0.5 transition-colors", form: { data: { turbo_frame: "_top" } } do %>
      <span class="material-symbols-outlined text-error text-[20px]" style="font-variation-settings: 'FILL' 1;">cancel</span>
    <% end %>
  <% else %>
    <%# Pending — empty circle, click to complete %>
    <% btn_class = is_overdue ? 'group-hover:text-error hover:text-error/80' : 'group-hover:text-primary hover:text-primary-container' %>
    <%= button_to task_path(task, task: { completed: true }), method: :patch, class: "z-10 relative mt-0.5 text-outline #{btn_class} transition-colors", form: { data: { turbo_frame: "_top" } } do %>
       <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 0;">radio_button_unchecked</span>
    <% end %>
  <% end %>
  <%= link_to task, data: { turbo_frame: "modal" }, class: "flex-1 min-w-0 outline-none before:absolute before:inset-0 before:z-0 cursor-pointer space-y-1" do %>
    <p class="text-sm font-medium leading-tight relative z-10 <%= is_done ? 'line-through opacity-70' : '' %> <%= is_overdue && !is_done ? 'text-error' : 'text-on-surface' %>"><%= task.title %></p>

    <div class="flex items-center gap-1.5 flex-wrap z-10 relative pointer-events-none">
      <%# Importance / Multiplier Badge %>
      <% mult = task.multiplier %>
      <% if mult.present? %>
        <% mult_bg = case mult.name.downcase
                     when /urgente/ then "bg-orange-950/80 text-orange-300 border-orange-800/50"
                     when /prioridade/ then "bg-amber-950/80 text-amber-300 border-amber-800/50"
                     when /estratégico|estrategico/ then "bg-purple-950/80 text-purple-300 border-purple-800/50"
                     else "bg-zinc-800 text-zinc-300 border-zinc-700"
                     end %>
        <span class="flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded border <%= mult_bg %>">
          <span class="material-symbols-outlined text-[11px]">star</span>
          <%= mult.name %>
        </span>
      <% else %>
        <span class="flex items-center gap-0.5 text-[10px] font-bold text-primary bg-primary/10 px-1.5 py-0.5 rounded-full border border-primary/20">
          <span class="material-symbols-outlined text-[11px]">star</span>
          <%= number_with_precision(task.score, precision: 1, strip_insignificant_zeros: true) %>
        </span>
      <% end %>

      <%# Estimated Time Badge %>
      <% if task.estimated_minutes.present? && task.estimated_minutes > 0 %>
        <span class="flex items-center gap-1 text-[10px] font-semibold text-on-surface-variant bg-surface-container-lowest px-1.5 py-0.5 rounded border border-outline-variant/60">
          <span class="material-symbols-outlined text-[11px]">timer</span>
          <%= task.estimated_minutes %>m
        </span>
      <% end %>

      <%# Recurrence Badge %>
      <% rec_val = task.try(:recurrence) %>
      <% if rec_val.present? && rec_val != "none" %>
        <% rec_label = case rec_val
                       when "daily" then "Diária"
                       when "weekly" then "Semanal"
                       when "monthly" then "Mensal"
                       else rec_val.humanize
                       end %>
        <span class="flex items-center gap-1 text-[10px] font-semibold text-indigo-300 bg-indigo-950/70 px-1.5 py-0.5 rounded border border-indigo-800/50">
          <span class="material-symbols-outlined text-[11px]">repeat</span>
          <%= rec_label %>
        </span>
      <% end %>

      <%# Images Badge %>
      <% if task.images.attached? %>
        <span class="flex items-center gap-1 text-[10px] font-semibold text-teal-300 bg-teal-950/70 px-1.5 py-0.5 rounded border border-teal-800/50">
          <span class="material-symbols-outlined text-[11px]">image</span>
          <%= task.images.count %>
        </span>
      <% end %>

      <%# OKR Badge %>
      <% if task.key_result.present? %>
        <span class="flex items-center gap-1 text-[10px] font-semibold text-sky-300 bg-sky-950/70 px-1.5 py-0.5 rounded border border-sky-800/50" title="<%= task.key_result.okr&.title || task.key_result.title %>">
          <span class="material-symbols-outlined text-[11px]">track_changes</span>
          OKR
        </span>
      <% end %>
    </div>
  <% end %>
</div>
